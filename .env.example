# Example environment variables
# Use the canonical public demo site
BASE_URL=https://demoblaze.com
# Dedicated API base (preferred for API tests)
API_BASE_URL=http://localhost:3000
# Backwards-compatible API URL variable (if used in your project)
API_URL=https://demoblaze.com
TEST_USERNAME=example_user
TEST_PASSWORD=example_pass
# Optional bearer token for API authentication
API_TOKEN=your_api_token_here
ENV=local
